      "why": "家具与地板：贴合是允许的，穿插不是。两个判定要分开。"
    },
    {
      "phase": "MEASURE",
      "label": "kw1",
      "tool": "collide",
      "args": {
        "a": "@chair.items",
        "b": "@walls.items[0]"
      },
      "why": "家具与第一面墙。"
    },
    {
      "phase": "MEASURE",
      "label": "kw2",
      "tool": "collide",
      "args": {
        "a": "@chair.items",
        "b": "@walls.items[1]"
      },
      "why": "家具与第二面墙。"
    },
    {
      "phase": "MEASURE",
      "label": "kw3",
      "tool": "collide",
      "args": {
        "a": "@chair.items",
        "b": "@walls.items[2]"
