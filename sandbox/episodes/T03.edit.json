          "dratio",
          "sol",
          "dzb",
          "secf",
          "lay1",
          "lay2",
          "lay3",
          "s12",
          "s123",
          "over"
        ]
      },
      "why": "八组量、两个口径的体积、反解高度都有工具出处；派生量由 calc 算出。提交。"
    }
  ]
